NODE_ENV=development
API_CONSOLE_PORT=4174
API_CONSOLE_CORS_ORIGIN=http://localhost:5173
API_CONSOLE_DATA_DIR=runtime/api-console
UTMS_DOMAIN_STATE_FILE=runtime/domain-rpc/utms-state.json
VITE_API_CONSOLE_BASE_URL=/api/api-console
VITE_DOMAIN_API_BASE_URL=/api/domain
VITE_DOMAIN_API_MODE=backend
VITE_DOMAIN_RPC_FALLBACK_COOLDOWN_MS=5000
VITE_DOMAIN_RPC_READ_CACHE_TTL_MS=750
VITE_DEV_API_PROXY_TARGET=http://localhost:4174
DATABASE_URL=postgresql://postgres:1234@localhost:5432/UTMS?schema=public
POSTGRES_DB=UTMS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password
WEB_PORT=5173
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=utms-private
S3_ACCESS_KEY_ID=utms-minio
S3_SECRET_ACCESS_KEY=change-this-development-secret
CDE_SESSION_ENCRYPTION_KEY=change-this-to-at-least-32-random-characters
UTMS_OBJECT_ENCRYPTION_KEY=change-this-to-an-independent-32-character-key
UTMS_INTERNAL_JOB_TOKEN=change-this-to-a-long-random-internal-token
CDE_MAX_BODY_BYTES=33554432
